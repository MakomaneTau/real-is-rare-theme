{% doc %}
  Non-interactive product placeholders for an outfit awaiting product selection.
{% enddoc %}
<div class="rare-editorial__products" aria-label="Outfit product placeholders">
  {% for index in (1..2) %}
    <div class="rare-editorial__product rare-editorial__product-placeholder">
      {{ 'product-apparel-1' | placeholder_svg_tag }}
      <span>Outfit piece 0{{ index }}<span class="rare-editorial__product-price">Product placeholder</span></span>
    </div>
  {% endfor %}
</div>
