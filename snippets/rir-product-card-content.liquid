{%- doc -%}
  Editorial contents for the existing product-card component.
  @param {product} product - Real Shopify product
  @param {string} [badge] - Merchant-authorized collection label
{%- enddoc -%}
{% liquid
  assign primary_image = product.featured_media.preview_image
  assign secondary_image = product.images[1]
  assign image_alt = primary_image.alt | default: product.title
%}
<a class="rir-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
  {% if primary_image != blank %}
    {{ primary_image | image_url: width: 1200 | image_tag: widths: '240, 360, 480, 640, 800, 1000, 1200', sizes: '(max-width: 749px) 80vw, (max-width: 989px) 45vw, 40vw', loading: 'lazy', class: 'rir-card__image', alt: image_alt }}
    {% if secondary_image != blank %}
      {{ secondary_image | image_url: width: 1200 | image_tag: widths: '240, 360, 480, 640, 800, 1000, 1200', sizes: '(max-width: 749px) 80vw, (max-width: 989px) 45vw, 40vw', loading: 'lazy', class: 'rir-card__image rir-card__image--secondary', alt: '' }}
    {% endif %}
  {% else %}
    {{ 'product-1' | placeholder_svg_tag: 'rir-card__placeholder' }}
  {% endif %}
  {% if product.available == false %}
    <span class="rir-card__badge">{{ 'content.product_badge_sold_out' | t }}</span>
  {% elsif badge != blank %}
    <span class="rir-card__badge">{{ badge | escape }}</span>
  {% endif %}
  <span class="rir-card__arrow" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
</a>
<div class="rir-card__details">
  <a class="rir-card__title" href="{{ product.url }}">{{ product.title | escape }}</a>
  <div class="rir-card__price">{% render 'price', product_resource: product, show_sale_price_first: true %}</div>
</div>
{% for option in product.options_with_values %}
  {% assign swatch_count = option.values | map: 'swatch' | compact | size %}
  {% if swatch_count > 0 %}
    <div class="rir-card__swatches" aria-label="{{ option.name | escape }}">
      {% for value in option.values %}
        {% if value.swatch != blank %}
          {% assign swatch_label = product.title | append: ': ' | append: value.name %}
          <a class="rir-card__swatch" href="{{ value.variant.url | default: product.url }}" aria-label="{{ swatch_label | escape }}">
            {% render 'swatch', swatch: value.swatch, mode: 'unscaled', label: value.name %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
    {% break %}
  {% endif %}
{% endfor %}
