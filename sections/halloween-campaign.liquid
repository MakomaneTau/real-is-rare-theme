{% if settings.halloween_enabled %}
  {% liquid
    assign shop_link = section.settings.shop_link | default: routes.all_products_collection_url
    assign campaign_alt = section.settings.image.alt | default: 'Neon pumpkin skull and jack-o-lanterns from the Real Is Rare Halloween campaign'
  %}
  <div class="halloween-campaign">
    <div class="halloween-campaign__hero halloween-campaign__inner">
      <div class="halloween-campaign__copy">
        <p class="halloween-campaign__eyebrow">{{ settings.halloween_date | escape }}</p>
        <h1 class="halloween-campaign__title">
          <span>{{ section.settings.heading | escape }}</span>
          <span>{{ section.settings.heading_second_line | escape }}</span>
        </h1>
        <p class="halloween-campaign__tagline">{{ section.settings.tagline | escape }}</p>
        <p class="halloween-campaign__description">{{ section.settings.description | escape }}</p>
        <div class="halloween-campaign__actions">
          <a class="halloween-campaign__button" href="#HalloweenOffers">
            {{ section.settings.button_label | escape }}
            <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </a>
          <a class="halloween-campaign__button halloween-campaign__button--secondary" href="{{ shop_link }}">
            {{ section.settings.shop_label | escape }}
            <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </a>
        </div>
      </div>
      <div class="halloween-campaign__artwork">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'halloween-campaign__image', widths: '390, 600, 800, 1000, 1400', sizes: '(min-width: 990px) 46vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: campaign_alt }}
        {% else %}
          <img
            class="halloween-campaign__image halloween-campaign__image--poster"
            src="{{ 'halloween-2026-poster.jpg' | asset_url }}"
            width="995"
            height="1280"
            alt="{{ campaign_alt | escape }}"
            loading="eager"
            fetchpriority="high"
          >
        {% endif %}
      </div>
    </div>

    <div class="halloween-campaign__ticker">
      <p>{{ section.settings.ticker | escape }}</p>
    </div>

    <div id="HalloweenOffers" class="halloween-campaign__offers halloween-campaign__inner" tabindex="-1">
      <div class="halloween-campaign__offers-header">
        <h2>{{ section.settings.offers_heading | escape }}</h2>
        <p>{{ settings.halloween_date | escape }}</p>
      </div>
      <ul class="halloween-campaign__grid" role="list">
        {% for block in section.blocks %}
          {% liquid
            assign offer_product = block.settings.product
            assign offer_image = block.settings.image | default: offer_product.featured_image
            assign offer_image_alt = offer_image.alt | default: block.settings.title
            assign offer_link = block.settings.link | default: offer_product.url | default: shop_link
            assign original_price = block.settings.original_price | plus: 0
            assign sale_price = block.settings.sale_price | plus: 0
            assign sale_price_money = sale_price | times: 100 | money
            assign original_price_money = original_price | times: 100 | money
            if settings.currency_code_enabled_product_cards
              assign sale_price_money = sale_price | times: 100 | money_with_currency
              assign original_price_money = original_price | times: 100 | money_with_currency
            endif
          %}
          <li {{ block.shopify_attributes }}>
            <article class="rir-site-product-card rir-product-card">
              <div class="product-card__content halloween-campaign__card-content">
                <a class="rir-card__media" href="{{ offer_link }}" aria-label="{{ block.settings.title | escape }}">
                  {% if offer_image != blank %}
                    {{ offer_image | image_url: width: 800 | image_tag: class: 'rir-card__image', widths: '180, 300, 400, 600, 800', sizes: '(min-width: 1200px) 20vw, (min-width: 750px) 33vw, 50vw', loading: 'lazy', alt: offer_image_alt }}
                  {% else %}
                    <div class="halloween-campaign__image-slot" aria-hidden="true">
                      {{ 'image' | placeholder_svg_tag: 'halloween-campaign__image-placeholder' }}
                      {% if request.design_mode %}<span>Add an offer image</span>{% endif %}
                    </div>
                  {% endif %}
                  <span class="rir-card__arrow" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
                </a>
                <div class="rir-card__details">
                  <a class="rir-card__title" href="{{ offer_link }}">{{ block.settings.title | escape }}</a>
                  <div class="rir-card__price">
                    <span class="price">
                      <span class="visually-hidden">Special price: </span>{{ sale_price_money }}
                    </span>
                    {% if original_price > sale_price %}
                      <span class="compare-at-price">
                        <span class="visually-hidden">Original price: </span>
                        <s>{{ original_price_money }}</s>
                      </span>
                    {% endif %}
                  </div>
                </div>
              </div>
            </article>
          </li>
        {% endfor %}
      </ul>
      <div class="halloween-campaign__shop-row">
        <p>{{ section.settings.offers_note | escape }}</p>
        <a class="halloween-campaign__button halloween-campaign__button--secondary" href="{{ shop_link }}">
          {{ section.settings.shop_label | escape }}
          <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </a>
      </div>
    </div>
    <div class="halloween-campaign__statement">
      <div class="halloween-campaign__inner">
        <h2>{{ section.settings.statement | escape | newline_to_br }}</h2>
        <p>{{ section.settings.statement_text | escape }}</p>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Halloween campaign",
  "tag": "section",
  "class": "halloween-campaign-section",
  "limit": 1,
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 20,
  "settings": [
    { "type": "paragraph", "content": "Enable Halloween edition in Theme settings to display this campaign. Offer prices are campaign copy; configure matching product prices or discounts in Shopify Admin." },
    { "type": "text", "id": "heading", "label": "Heading, first line", "default": "Halloween" },
    { "type": "text", "id": "heading_second_line", "label": "Heading, second line", "default": "Special" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Rare after dark." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Your favourite fits. Frightfully good prices. The Real Is Rare Halloween special lands Friday, 30 October." },
    { "type": "image_picker", "id": "image", "label": "Campaign artwork", "info": "Leave empty to use the supplied 2026 Halloween poster." },
    { "type": "text", "id": "button_label", "label": "Offers button label", "default": "Explore the offers" },
    { "type": "text", "id": "shop_label", "label": "Shop button label", "default": "Shop all pieces" },
    { "type": "url", "id": "shop_link", "label": "Shop destination", "info": "Defaults to All Products. Individual offer destinations can be set on each block." },
    { "type": "text", "id": "ticker", "label": "Campaign strip", "default": "Rare finds. / Wicked prices. / Real Is Rare." },
    { "type": "text", "id": "offers_heading", "label": "Offers heading", "default": "All treats. No tricks." },
    { "type": "text", "id": "offers_note", "label": "Offers note", "default": "Any T-shirt design in store: R350" },
    { "type": "textarea", "id": "statement", "label": "Brand statement", "default": "Same rare energy.\nA darker side." },
    { "type": "text", "id": "statement_text", "label": "Statement supporting text", "default": "Turn up in something rare this Halloween." }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Halloween offer",
      "settings": [
        { "type": "text", "id": "title", "label": "Offer name", "default": "Halloween offer" },
        { "type": "image_picker", "id": "image", "label": "Offer image", "info": "Upload or select the image for this offer. Overrides the selected product's photo." },
        { "type": "product", "id": "product", "label": "Product photo source", "info": "Optional. Uses this product's featured image when Offer image is empty." },
        { "type": "number", "id": "sale_price", "label": "Special price", "default": 350, "info": "Amount in the shop's currency, for example 350 for R350." },
        { "type": "number", "id": "original_price", "label": "Original price", "default": 0, "info": "Leave at 0 to omit. Only shown when greater than the special price." },
        { "type": "url", "id": "link", "label": "Offer destination" }
      ]
    }
  ],
  "presets": [ { "name": "Halloween campaign" } ]
}
{% endschema %}
