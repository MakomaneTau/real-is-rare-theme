{% if settings.halloween_enabled %}
  {% liquid
    assign campaign_collection = section.settings.collection
    assign shop_link = campaign_collection.url
    assign campaign_alt = section.settings.image.alt | default: 'Neon pumpkin skull and jack-o-lanterns from the Real Is Rare Halloween campaign'
  %}
  <div class="halloween-campaign">
    <div class="halloween-campaign__hero halloween-campaign__inner">
      <div class="halloween-campaign__copy">
        <p class="halloween-campaign__eyebrow">{{ settings.halloween_date | escape }}</p>
        <h1 class="halloween-campaign__title">
          <span>{{ section.settings.heading | escape }}</span>
          <span>{{ section.settings.heading_second_line | escape }}</span>
        </h1>
        <p class="halloween-campaign__tagline">{{ section.settings.tagline | escape }}</p>
        <p class="halloween-campaign__description">{{ section.settings.description | escape }}</p>
        <div class="halloween-campaign__actions">
          <a class="halloween-campaign__button" href="#HalloweenOffers">
            {{ section.settings.button_label | escape }}
            <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </a>
          {% if shop_link != blank %}
          <a class="halloween-campaign__button halloween-campaign__button--secondary" href="{{ shop_link }}">
            {{ section.settings.shop_label | escape }}
            <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </a>
          {% endif %}
        </div>
      </div>
      <div class="halloween-campaign__artwork">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'halloween-campaign__image', widths: '390, 600, 800, 1000, 1400', sizes: '(min-width: 990px) 46vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: campaign_alt }}
        {% else %}
          <img
            class="halloween-campaign__image halloween-campaign__image--poster"
            src="{{ 'halloween-2026-poster.jpg' | asset_url }}"
            width="995"
            height="1280"
            alt="{{ campaign_alt | escape }}"
            loading="eager"
            fetchpriority="high"
          >
        {% endif %}
      </div>
    </div>

    <div class="halloween-campaign__ticker">
      <p>{{ section.settings.ticker | escape }}</p>
    </div>

    <div id="HalloweenOffers" class="halloween-campaign__offers halloween-campaign__inner" tabindex="-1">
      <div class="halloween-campaign__offers-header">
        <h2>{{ section.settings.offers_heading | escape }}</h2>
        <p>{{ settings.halloween_date | escape }}</p>
      </div>
      {% if campaign_collection.products_count > 0 %}
        {% paginate campaign_collection.products by 50 %}
          <ul class="halloween-campaign__grid" role="list">
            {% for product in campaign_collection.products %}
              <li>
                <article class="rir-site-product-card rir-product-card">
                  <div class="product-card__content halloween-campaign__card-content">
                    {% render 'rir-product-card-content', product: product %}
                  </div>
                </article>
              </li>
            {% endfor %}
          </ul>
          {% if paginate.pages > 1 %}
            <nav aria-label="{{ 'content.pagination.nav_label' | t }}">
              {{ paginate | default_pagination: anchor: 'HalloweenOffers' }}
            </nav>
          {% endif %}
        {% endpaginate %}
      {% elsif request.design_mode %}
        <p>Select a collection with published products in the Halloween campaign settings.</p>
      {% endif %}
      <div class="halloween-campaign__shop-row">
        {% if shop_link != blank %}
        <a class="halloween-campaign__button halloween-campaign__button--secondary" href="{{ shop_link }}">
          {{ section.settings.shop_label | escape }}
          <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </a>
        {% endif %}
      </div>
    </div>
    <div class="halloween-campaign__statement">
      <div class="halloween-campaign__inner">
        <h2>{{ section.settings.statement | escape | newline_to_br }}</h2>
        <p>{{ section.settings.statement_text | escape }}</p>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Halloween campaign",
  "tag": "section",
  "class": "halloween-campaign-section",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Enable Halloween edition in Theme settings. Products, images and prices come directly from the selected Shopify collection in its sort order."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Campaign collection",
      "info": "Select Halloween Sale. Only products in this collection are displayed; manage products and prices in Shopify Admin."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading, first line",
      "default": "Halloween"
    },
    {
      "type": "text",
      "id": "heading_second_line",
      "label": "Heading, second line",
      "default": "Special"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Rare after dark."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Your favourite fits. Frightfully good prices. The Real Is Rare Halloween special lands Friday, 30 October."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Campaign artwork",
      "info": "Leave empty to use the supplied 2026 Halloween poster."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Offers button label",
      "default": "Explore the offers"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop button label",
      "default": "Shop all pieces"
    },
    {
      "type": "text",
      "id": "ticker",
      "label": "Campaign strip",
      "default": "Rare finds. / Wicked prices. / Real Is Rare."
    },
    {
      "type": "text",
      "id": "offers_heading",
      "label": "Offers heading",
      "default": "All treats. No tricks."
    },
    {
      "type": "textarea",
      "id": "statement",
      "label": "Brand statement",
      "default": "Same rare energy.\nA darker side."
    },
    {
      "type": "text",
      "id": "statement_text",
      "label": "Statement supporting text",
      "default": "Turn up in something rare this Halloween."
    }
  ],
  "presets": [
    {
      "name": "Halloween campaign"
    }
  ]
}
{% endschema %}
