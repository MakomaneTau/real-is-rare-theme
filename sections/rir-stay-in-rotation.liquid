{% liquid
  assign rotation_collection = section.settings.collection
  assign badge = ''
  if section.settings.show_badges
    assign badge = 'THE ROTATION'
  endif
  assign groups = 'all,pants,outerwear,sets' | split: ','
  assign labels = 'ALL PIECES,PANTS,OUTERWEAR,SETS' | split: ','
%}
{% if rotation_collection.products.size > 0 or request.design_mode %}
  <rir-rotation class="rir-section rir-rotation" aria-labelledby="RirHeading-{{ section.id }}" style="--rir-tile-background: {{ section.settings.tile_background }};">
    <div class="rir-section__inner">
      <div class="rir-section__header">
  <div>
    {% if section.settings.eyebrow != blank %}<p class="rir-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2 id="RirHeading-{{ section.id }}" class="rir-section__heading">{{ section.settings.heading | escape }}</h2>
    {% if section.settings.subtitle != blank %}<p class="rir-section__subtitle">{{ section.settings.subtitle | escape }}</p>{% endif %}
  </div>
  {% assign cta_url = section.settings.cta_link | default: section.settings.collection.url %}
  {% if cta_url != blank and section.settings.cta_label != blank %}
    <a class="rir-section__cta" href="{{ cta_url }}">{{ section.settings.cta_label | escape }}<span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span></a>
  {% endif %}
</div>
      <div class="rir-rotation__filters" data-filters role="group" aria-label="Product categories" hidden>
        {% for group in groups %}
          <button type="button" class="rir-rotation__filter" data-filter="{{ group }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="RirPanel-{{ section.id }}-{{ group }}">{{ labels[forloop.index0] }}</button>
        {% endfor %}
      </div>
      <noscript><div class="rir-rotation__fallback">
        {% for group in groups %}
          {% assign group_collection = rotation_collection %}
          {% unless forloop.first %}{% assign collection_key = group | append: '_collection' %}{% assign group_collection = section.settings[collection_key] %}{% endunless %}
          {% if group_collection != blank %}<a href="{{ group_collection.url }}">{{ labels[forloop.index0] }}</a>{% endif %}
        {% endfor %}
      </div></noscript>
      {% for group in groups %}
        {% assign group_collection = rotation_collection %}
        {% unless forloop.first %}{% assign collection_key = group | append: '_collection' %}{% assign group_collection = section.settings[collection_key] %}{% endunless %}
        <div id="RirPanel-{{ section.id }}-{{ group }}" data-panel="{{ group }}" role="region" aria-label="{{ labels[forloop.index0] }}" {% unless forloop.first %}hidden{% endunless %}>
          {% if group_collection.products.size > 0 %}
            <ul class="rir-rotation__grid" role="list">
              {% for product in group_collection.products limit: section.settings.card_count %}
                {% assign instance = section.id | append: '-' | append: group | append: '-' | append: forloop.index %}
                <li>{% render 'product-card', product: product, editorial: true, card_instance_id: instance, badge: badge, product_view_context: 'homepage-rotation' %}</li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="rir-section__empty">{{ section.settings.empty_text | escape }}{% if request.design_mode %} Select the {{ labels[forloop.index0] }} collection in this section's settings.{% endif %}</p>
          {% endif %}
        </div>
      {% endfor %}
      <p class="visually-hidden" role="status" aria-live="polite" data-filter-status></p>
    </div>
  </rir-rotation>
{% endif %}

{% schema %}
{
  "name": "Stay in Rotation",
  "tag": "section",
  "class": "rir-home-section",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE EVERYDAY ROTATION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "STAY IN ROTATION."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Supporting text",
      "default": "Selected pieces for your everyday rotation."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "All Pieces collection"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Collection link label",
      "default": "SHOP ALL PIECES"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Collection link override"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show collection badges",
      "default": true
    },
    {
      "type": "select",
      "id": "tile_background",
      "label": "Product tile background",
      "options": [
        {
          "value": "#f4f4f2",
          "label": "Soft neutral"
        },
        {
          "value": "#f6f6f6",
          "label": "Light grey"
        }
      ],
      "default": "#f4f4f2"
    },
    {
      "type": "range",
      "id": "card_count",
      "label": "Products per category",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "paragraph",
      "content": "Filters use the collections you choose below, never guessed product tags. Add and reorder products in Shopify Admin."
    },
    {
      "type": "collection",
      "id": "pants_collection",
      "label": "Pants collection"
    },
    {
      "type": "collection",
      "id": "outerwear_collection",
      "label": "Outerwear collection"
    },
    {
      "type": "collection",
      "id": "sets_collection",
      "label": "Sets collection"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty category message",
      "default": "No pieces in this selection yet. Explore All Pieces."
    }
  ],
  "presets": [
    {
      "name": "Stay in Rotation"
    }
  ]
}
{% endschema %}
