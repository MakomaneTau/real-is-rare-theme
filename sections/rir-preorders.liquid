{% liquid
  assign preorder_collection = section.settings.collection
  assign cta_url = section.settings.cta_link | default: preorder_collection.url
%}
{% if preorder_collection.products.size > 0 or request.design_mode %}
  <div class="rir-section rir-preorder" aria-labelledby="RirHeading-{{ section.id }}" style="--rir-tile-background: {{ section.settings.tile_background }};">
    <div class="rir-section__inner">
      <div class="rir-section__header">
        <div>
          {% if section.settings.eyebrow != blank %}
            <p class="rir-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          <h2 id="RirHeading-{{ section.id }}" class="rir-section__heading">{{ section.settings.heading | escape }}</h2>
          {% if section.settings.subtitle != blank %}
            <p class="rir-section__subtitle">{{ section.settings.subtitle | escape }}</p>
          {% endif %}
        </div>
        {% if cta_url != blank and section.settings.cta_label != blank %}
          <a class="rir-section__cta" href="{{ cta_url }}">
            {{ section.settings.cta_label | escape }}
            <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </a>
        {% endif %}
      </div>
      {% if preorder_collection.products.size > 0 %}
        <ul class="rir-preorder__grid" role="list" aria-label="{{ section.settings.heading | escape }}">
          {% for product in preorder_collection.products limit: section.settings.card_count %}
            {% assign instance = section.id | append: '-preorder-' | append: forloop.index %}
            <li>{% render 'product-card', product: product, editorial: true, card_instance_id: instance, product_view_context: 'homepage-preorders' %}</li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="rir-section__empty">Choose a collection of pre-order products in this section's settings. This message is only visible in the Theme Editor.</p>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Pre-Orders",
  "tag": "section",
  "class": "rir-home-section",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MADE TO ORDER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PRE-ORDERS."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Supporting text",
      "default": "Made just for you."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Pre-order collection",
      "info": "Select the existing made-to-order products. These pieces are made after an order is placed and do not need to be stocked in the physical store."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Collection link label",
      "default": "EXPLORE PRE-ORDERS"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Collection link override"
    },
    {
      "type": "select",
      "id": "tile_background",
      "label": "Product tile background",
      "options": [
        {
          "value": "#f4f4f2",
          "label": "Soft neutral"
        },
        {
          "value": "#f6f6f6",
          "label": "Light grey"
        }
      ],
      "default": "#f4f4f2"
    },
    {
      "type": "range",
      "id": "card_count",
      "label": "Product count",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Pre-Orders"
    }
  ]
}
{% endschema %}
