{{ 'rare-editorial.css' | asset_url | stylesheet_tag }}
{% assign campaign_image = collection.metafields.custom.campaign_image.value | default: section.settings.image | default: collection.image %}
<section class="rare-editorial rare-collection-intro">
  <div class="rare-editorial__heading">
    <div><p class="rare-editorial__eyebrow">REAL IS RARE / COLLECTION</p><h1 class="rare-editorial__title">{{ collection.title | escape }}</h1></div>
    {% if collection.description != blank %}<div class="rare-editorial__intro">{{ collection.description }}</div>{% endif %}
  </div>
  <div class="rare-editorial__photo">
    {% if campaign_image != blank %}
      {% render 'campaign-image', image: campaign_image, mobile_image: section.settings.mobile_image, alt: collection.title %}
    {% else %}
      <div class="rare-editorial__placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag }}<p>Wide campaign photograph of models wearing this collection. Keep faces and garments near the center for mobile cropping.</p></div>
    {% endif %}
  </div>
</section>
{% stylesheet %}
.rare-collection-intro .rare-editorial__photo { aspect-ratio: 3 / 1; max-height: 420px; }
@media (max-width: 749px) { .rare-collection-intro .rare-editorial__photo { aspect-ratio: 4 / 3; } }
{% endstylesheet %}
{% schema %}
{"name":"Collection campaign","enabled_on":{"templates":["collection"]},"settings":[{"type":"image_picker","id":"image","label":"Campaign photograph","info":"Uses the collection custom.campaign_image metafield or collection image when available."},{"type":"image_picker","id":"mobile_image","label":"Mobile crop"}],"presets":[{"name":"Collection campaign"}]}
{% endschema %}
