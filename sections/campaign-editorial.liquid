{{ 'rare-editorial.css' | asset_url | stylesheet_tag }}
{% assign campaign_link = section.settings.link %}
{% if campaign_link contains 'view=lookbook' or campaign_link contains '/pages/lookbook' %}
  {% capture campaign_link %}{% render 'lookbook-url' %}{% endcapture %}
  {% assign campaign_link = campaign_link | strip %}
{% endif %}
<section class="rare-editorial rare-editorial--{{ section.settings.layout }}" aria-labelledby="CampaignTitle-{{ section.id }}">
  <div class="rare-editorial__heading">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="rare-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.page_heading %}<h1 class="rare-editorial__title" id="CampaignTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h1>{% else %}<h2 class="rare-editorial__title" id="CampaignTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.intro != blank %}<p class="rare-editorial__intro">{{ section.settings.intro | escape }}</p>{% endif %}
    </div>
    {% if campaign_link != blank %}<a href="{{ campaign_link }}">{{ section.settings.link_label | escape }} &rarr;</a>{% endif %}
  </div>
  <div class="rare-editorial__grid">
    {% for block in section.blocks %}
      <article class="rare-editorial__look" {{ block.shopify_attributes }}>
        <div class="rare-editorial__photo">
          {% if block.settings.image != blank %}
            {% render 'campaign-image', image: block.settings.image, mobile_image: block.settings.mobile_image, alt: block.settings.alt %}
          {% else %}
            <div class="rare-editorial__placeholder">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
              <p>{{ block.settings.shot_brief | escape }}</p>
            </div>
          {% endif %}
        </div>
        <div>
          <div class="rare-editorial__caption">
            <h3>{{ block.settings.title | escape }}</h3>
            {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} &rarr;</a>{% endif %}
          </div>
          {% if block.settings.products != blank %}
            <div class="rare-editorial__products">
              {% for look_product in block.settings.products %}
                <a class="rare-editorial__product" href="{{ look_product.url }}">
                  {% if look_product.featured_image %}{{ look_product.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: look_product.title }}{% endif %}
                  <span>{{ look_product.title | escape }}<span class="rare-editorial__product-price">{{ look_product.price | money }}{% unless look_product.available %} · {{ 'content.product_badge_sold_out' | t }}{% endunless %}</span></span>
                </a>
              {% endfor %}
            </div>
          {% elsif section.settings.layout == 'shop' %}
            {% render 'outfit-product-placeholders' %}
            {% if request.design_mode %}<p class="rare-editorial__footer">Select the products worn in this look using this photograph’s settings.</p>{% endif %}
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Campaign editorial",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "shop",
          "label": "Shop the look"
        },
        {
          "value": "pair",
          "label": "Campaign photo pair"
        },
        {
          "value": "lookbook",
          "label": "Lookbook grid"
        }
      ],
      "default": "pair"
    },
    {
      "type": "checkbox",
      "id": "page_heading",
      "label": "Use as page heading",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "REAL IS RARE / CAMPAIGN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In the frame"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Photograph / look",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop photograph"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile photograph"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Caption",
          "default": "LOOK 01"
        },
        {
          "type": "textarea",
          "id": "shot_brief",
          "label": "Placeholder / shot description",
          "default": "Full-body model photograph. Show the complete outfit with space around the head and shoes."
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products worn in this photograph",
          "limit": 4
        },
        {
          "type": "url",
          "id": "link",
          "label": "Look link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Look link label",
          "default": "Shop this look"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Campaign editorial",
      "blocks": [
        {
          "type": "look"
        },
        {
          "type": "look"
        }
      ]
    }
  ]
}
{% endschema %}
