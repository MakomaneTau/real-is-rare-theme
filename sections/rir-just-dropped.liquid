{% liquid
  assign drop_collection = section.settings.collection
  assign card_limit = section.settings.card_count | plus: 0
  assign badge = ''
  if section.settings.show_badges
    assign badge = 'NEW'
  endif
%}
{% if drop_collection.products.size > 0 or request.design_mode %}
  <div class="rir-section rir-drop" aria-labelledby="RirHeading-{{ section.id }}" style="--rir-tile-background: {{ section.settings.tile_background }};">
    <div class="rir-section__inner">
      <div class="rir-section__header">
  <div>
    {% if section.settings.eyebrow != blank %}<p class="rir-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2 id="RirHeading-{{ section.id }}" class="rir-section__heading">{{ section.settings.heading | escape }}</h2>
    {% if section.settings.subtitle != blank %}<p class="rir-section__subtitle">{{ section.settings.subtitle | escape }}</p>{% endif %}
  </div>
  {% assign cta_url = section.settings.cta_link | default: section.settings.collection.url %}
  {% if cta_url != blank and section.settings.cta_label != blank %}
    <a class="rir-section__cta" href="{{ cta_url }}">{{ section.settings.cta_label | escape }}<span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span></a>
  {% endif %}
</div>
      {% if drop_collection.products.size > 0 %}
        <ul class="rir-drop__grid rir-drop__grid--{{ card_limit }}" role="list" aria-label="{{ section.settings.heading | escape }}" tabindex="0">
          {% for product in drop_collection.products limit: card_limit %}
            {% assign instance = section.id | append: '-drop-' | append: forloop.index %}
            <li>{% render 'product-card', product: product, editorial: true, card_instance_id: instance, badge: badge, product_view_context: 'homepage-new-drops' %}</li>
          {% endfor %}
        </ul>
      {% else %}
        <div class="rir-section__empty">Choose a New Drops collection with products in this section's settings. This message is only visible in the Theme Editor.</div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Just Dropped",
  "tag": "section",
  "class": "rir-home-section",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEW RELEASES / JUST DROPPED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JUST DROPPED."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Supporting text",
      "default": "The latest from Real is Rare."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection",
      "info": "Choose the New Drops collection. Membership authorizes the NEW badge; its Shopify sort order controls the cards."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Collection link label",
      "default": "SHOP THE DROP"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Collection link override"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show collection badges",
      "default": true
    },
    {
      "type": "select",
      "id": "tile_background",
      "label": "Product tile background",
      "options": [
        {
          "value": "#f4f4f2",
          "label": "Soft neutral"
        },
        {
          "value": "#f6f6f6",
          "label": "Light grey"
        }
      ],
      "default": "#f4f4f2"
    },
    {
      "type": "select",
      "id": "card_count",
      "label": "Product count",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3"
    }
  ],
  "presets": [
    {
      "name": "Just Dropped"
    }
  ]
}
{% endschema %}
