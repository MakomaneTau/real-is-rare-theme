{% doc %}
  @prompt
    Create a product-page customization block for the Personalised World Cup Quest Jersey that lets shoppers enter a printed name and printed number, adds both selections to the order, and shows clear labels and helpful instructions. Display the block only on this product and keep the existing size selector unchanged.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if product and block.settings.target_product and product.id == block.settings.target_product.id %}
  {% style %}
    .ai-jersey-personalization-{{ ai_gen_id }} {
      display: block;
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
      padding: 20px;
      background: {{ block.settings.background_color }};
      color: {{ block.settings.text_color }};
      border: 1px solid {{ block.settings.border_color }};
    }

    .ai-jersey-personalization-{{ ai_gen_id }}__heading {
      margin: 0 0 8px;
      color: {{ block.settings.text_color }};
      font-family: {{ settings.type_heading_font.family }};
      font-size: 24px;
      line-height: 1.15;
    }

    .ai-jersey-personalization-{{ ai_gen_id }}__instructions {
      margin: 0 0 18px;
      color: {{ block.settings.muted_text_color }};
      font-size: 14px;
      line-height: 1.5;
    }

    .ai-jersey-personalization-{{ ai_gen_id }}__fields {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .ai-jersey-personalization-{{ ai_gen_id }}__field {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .ai-jersey-personalization-{{ ai_gen_id }}__label {
      color: {{ block.settings.text_color }};
      font-size: 13px;
      font-weight: 700;
    }

    .ai-jersey-personalization-{{ ai_gen_id }}__input {
      width: 100%;
      min-height: 46px;
      padding: 11px 12px;
      color: {{ settings.palette_input_text }};
      background: {{ settings.palette_input_background }};
      border: {{ settings.input_border_width }}px solid {{ settings.palette_input_border }};
      border-radius: {{ settings.inputs_border_radius }}px;
      font: inherit;
      box-sizing: border-box;
    }

    .ai-jersey-personalization-{{ ai_gen_id }}__input:focus {
      outline: 2px solid {{ block.settings.text_color }};
      outline-offset: 2px;
    }

    .ai-jersey-personalization-{{ ai_gen_id }}__note {
      margin: 14px 0 0;
      color: {{ block.settings.muted_text_color }};
      font-size: 12px;
      line-height: 1.45;
    }

    @media screen and (max-width: 749px) {
      .ai-jersey-personalization-{{ ai_gen_id }}__fields {
        grid-template-columns: 1fr;
      }
    }
  {% endstyle %}

  <div class="ai-jersey-personalization-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    {% if block.settings.heading != blank %}
      <h2 class="ai-jersey-personalization-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    {% if block.settings.instructions != blank %}
      <p class="ai-jersey-personalization-{{ ai_gen_id }}__instructions">{{ block.settings.instructions | escape }}</p>
    {% endif %}

    <div class="ai-jersey-personalization-{{ ai_gen_id }}__fields">
      <div class="ai-jersey-personalization-{{ ai_gen_id }}__field">
        <label class="ai-jersey-personalization-{{ ai_gen_id }}__label" for="ai-jersey-name-{{ ai_gen_id }}">{{ block.settings.name_label | escape }}</label>
        <input class="ai-jersey-personalization-{{ ai_gen_id }}__input" id="ai-jersey-name-{{ ai_gen_id }}" type="text" name="properties[Printed name]" maxlength="{{ block.settings.name_max_length }}" autocomplete="off" required aria-required="true" placeholder="{{ block.settings.name_placeholder | escape }}">
      </div>

      <div class="ai-jersey-personalization-{{ ai_gen_id }}__field">
        <label class="ai-jersey-personalization-{{ ai_gen_id }}__label" for="ai-jersey-number-{{ ai_gen_id }}">{{ block.settings.number_label | escape }}</label>
        <input class="ai-jersey-personalization-{{ ai_gen_id }}__input" id="ai-jersey-number-{{ ai_gen_id }}" type="text" name="properties[Printed number]" inputmode="numeric" pattern="[0-9]+" maxlength="{{ block.settings.number_max_length }}" autocomplete="off" required aria-required="true" placeholder="{{ block.settings.number_placeholder | escape }}">
      </div>
    </div>

    {% if block.settings.note != blank %}
      <p class="ai-jersey-personalization-{{ ai_gen_id }}__note">{{ block.settings.note | escape }}</p>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Jersey personalization",
  "settings": [
    {
      "type": "header",
      "content": "Product targeting"
    },
    {
      "type": "product",
      "id": "target_product",
      "label": "Show on product"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Personalise your jersey"
    },
    {
      "type": "textarea",
      "id": "instructions",
      "label": "Instructions",
      "default": "Enter the name and number you would like printed on your World Cup Quest Jersey."
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "Printed name"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "Enter your name"
    },
    {
      "type": "range",
      "id": "name_max_length",
      "label": "Name character limit",
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 15
    },
    {
      "type": "text",
      "id": "number_label",
      "label": "Number label",
      "default": "Printed number"
    },
    {
      "type": "text",
      "id": "number_placeholder",
      "label": "Number placeholder",
      "default": "Enter 1-2 digits"
    },
    {
      "type": "range",
      "id": "number_max_length",
      "label": "Number character limit",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Helpful note",
      "default": "Please check your spelling and number before adding the jersey to your cart."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f5f5f2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#070707"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Secondary text",
      "default": "#454545"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#262626"
    }
  ],
  "presets": [
    {
      "name": "Jersey personalization"
    }
  ],
  "tag": null,
  "class": "jersey-personalization-block"
}
{% endschema %}