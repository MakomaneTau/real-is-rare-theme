{% doc %}
  @prompt
    generate a summer sales banner
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-summer-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    text-align: {{ block.settings.text_alignment }};
    position: relative;
    box-sizing: border-box;
    border-bottom: 1px solid currentColor;
  }

  .ai-summer-banner-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .ai-summer-banner-copy-{{ ai_gen_id }} {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .ai-summer-banner-badge-{{ ai_gen_id }} {
    display: inline-block;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: {{ block.settings.badge_text_color }};
    background-color: {{ block.settings.badge_background_color }};
    padding: 6px 10px;
    margin-bottom: 14px;
  }

  .ai-summer-banner-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    font-family: var(--font-body--family);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.045em;
    color: inherit;
    margin: 0 0 10px;
    line-height: 1;
  }

  .ai-summer-banner-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_font_size }}px;
    margin: 0;
    line-height: 1.5;
  }

  .ai-summer-banner-button-{{ ai_gen_id }} {
    --button-hover-fill: {{ block.settings.button_hover_background_color }};
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-shrink: 0;
    min-height: 48px;
    max-width: 100%;
    box-sizing: border-box;
    padding: 16px 24px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.button_font_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    transition: background-color 0.2s ease, color 0.2s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-summer-banner-button-{{ ai_gen_id }}:is(:hover, :focus-visible) {
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-summer-banner-button-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-summer-banner-button-{{ ai_gen_id }} {
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-summer-banner-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px max(20px, {{ block.settings.padding_horizontal | times: 0.7 }}px);
    }

    .ai-summer-banner-container-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: {% case block.settings.text_alignment %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};
      gap: 24px;
    }

    .ai-summer-banner-heading-{{ ai_gen_id }} {
      font-size: clamp(28px, 8vw, {{ block.settings.heading_font_size }}px);
    }

    .ai-summer-banner-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_font_size }}px;
    }

    .ai-summer-banner-badge-{{ ai_gen_id }} {
      font-size: {{ block.settings.badge_font_size }}px;
    }
  }
{% endstyle %}

<div class="ai-summer-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-summer-banner-container-{{ ai_gen_id }}">
    <div class="ai-summer-banner-copy-{{ ai_gen_id }}">
      {% if block.settings.badge_text != blank %}
        <div class="ai-summer-banner-badge-{{ ai_gen_id }}">
          {{ block.settings.badge_text | escape }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-summer-banner-heading-{{ ai_gen_id }}">
          {{ block.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-summer-banner-subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading | escape }}
        </div>
      {% endif %}
    </div>

    {% if block.settings.button_text != blank and block.settings.button_link != blank %}
      <a href="{{ block.settings.button_link | escape }}" class="ai-summer-banner-button-{{ ai_gen_id }} button-fill">
        {{ block.settings.button_text | escape }}
        <span aria-hidden="true">&rarr;</span>
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Summer sales banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Summer Sale"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Up to 50% Off"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Limited time offer on selected items"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#a3a3a3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#070707"
    },
    {
      "type": "header",
      "content": "Badge style"
    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "Background",
      "default": "#070707"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Text",
      "default": "#f5f5f2"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Font size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Background",
      "default": "#070707"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text",
      "default": "#f5f5f2"
    },
    {
      "type": "color",
      "id": "button_hover_background_color",
      "label": "Hover background",
      "default": "#f5f5f2"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text",
      "default": "#070707"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border",
      "default": "#070707"
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Summer sales banner"
    }
  ]
}
{% endschema %}
